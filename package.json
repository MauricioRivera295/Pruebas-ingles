{
  "name": "pronunciation-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Practica de pronunciacion con reconocimiento de voz (Whisper via Transformers.js) corriendo en el servidor; el audio no se persiste en base de datos",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm run start"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bootstrap": "^5.3.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.24.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.0"
  }
}
